rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Fabrics inventory: readable by any authenticated user (incl. anonymous),
    // writes allowed to authenticated users.
    match /fabrics/{fabricId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;

      // History subcollection for fabric changes
      match /history/{historyId} {
        allow read, write: if request.auth != null;
      }
    }

    // Orders: readable/writable by authenticated users
    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }

    // Samples inventory: readable/writable by authenticated users
    match /samples/{sampleId} {
      allow read, write: if request.auth != null;
    }

    // Users collection keyed by email (app stores docs with email IDs)
    // Limit read/write to the same signed-in email holder
    match /users/{userId} {
      allow read, write: if request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
